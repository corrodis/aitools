# slack-mcp secrets and allowlist -- copy to the deploy root, fill in, chmod 600.
# Referenced by the systemd unit via EnvironmentFile=; systemd reads KEY=VALUE
# lines, so do not quote or export.

# Bot User OAuth Token (xoxb-...) of a Slack app with channels:history,
# channels:read, users:read (+ groups:history, groups:read for private
# channels). The bot must be invited to every channel listed below.
SLACK_BOT_TOKEN=xoxb-

# The ONLY channels this server can list or read: names (without #) or ids,
# comma separated. Everything else does not exist for callers.
SLACK_MCP_CHANNELS=mu2e-shift

# Hard cap on messages returned per call (default 500).
#SLACK_MCP_MAX_MESSAGES=500

# mikey bearer-token auth for the HTTP transport; unset = auth disabled.
#   On mu2eaigpvm01 the other gated servers use:
#MIKEY_KEYS_FILE=/exp/mu2e/app/users/mu2eai/mcp/mikey/keys
