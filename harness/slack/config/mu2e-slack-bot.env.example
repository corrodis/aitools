# mu2e-slack-bot secrets -- copy to the deploy root, fill in, chmod 600.
#
# Referenced by the systemd unit via EnvironmentFile=. Never passed on the
# command line: argv is visible to every user on a shared machine via `ps`.
# systemd reads this as KEY=VALUE lines, so do not quote or export.

# Slack app credentials (https://api.slack.com/apps -> your app)
#   SLACK_BOT_TOKEN  "OAuth & Permissions" -> Bot User OAuth Token (xoxb-...)
#   SLACK_APP_TOKEN  "Basic Information" -> App-Level Tokens, scope
#                    connections:write (xapp-...). Socket Mode needs this.
SLACK_BOT_TOKEN=xoxb-
SLACK_APP_TOKEN=xapp-

# Bearer token for the token-gated MCP servers (ecl, runs, memory).
# Collaboration-wide token for shared infrastructure -- everything the bot
# stores in the memory MCP is owned by this token's identity, not by the
# person who happened to ask.
MIKEY_TOKEN=

# Only needed if the LLM endpoint requires a key. vllm.fnal.gov does not;
# litellm.fnal.gov does.
#OPENAI_API_KEY=

# Optional: also write usage records to the shared Postgres table
# (harness/usage/sessions.sql). Not secret -- Kerberos is the credential, so
# point KRB5CCNAME at this account's auto-renewed ticket.
#LOG_PG_DSN=host=ifdb11 port=5477 dbname=mu2e_ai_prd
#KRB5CCNAME=/tmp/krb5cc_18199_auto
